<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:theme="?appbar_theme"
    app:elevation="0dp"
    app:liftOnScroll="false">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        android:background="@drawable/toolbar_background"
        app:popupTheme="?popup_theme"
        app:titleTextAppearance="@style/Toolbar.TitleText"
        app:subtitleTextAppearance="@style/Toolbar.Subtitle"
        app:titleTextColor="?title_color"
        app:subtitleTextColor="?subtitle_color" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height"
        android:minHeight="@dimen/tab_bar_height"
        android:background="@drawable/tab_bar_background"
        android:visibility="gone"
        app:tabGravity="fill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="?colorAccent"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2.5dp"
        app:tabIndicatorGravity="bottom"
        app:tabPaddingTop="0dp"
        app:tabPaddingBottom="0dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?colorAccent"
        app:tabTextAppearance="@style/TextAppearance.Design.Tab"
        app:tabTextColor="?android:textColorSecondary" />

</com.google.android.material.appbar.AppBarLayout>
