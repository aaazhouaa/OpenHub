<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    app:statusBarBackground="?attr/top_bar_background"
    tools:context="com.thirtydegreesray.openhub.ui.activity.MainActivity">

    <include layout="@layout/layout_appbar" />

    <include layout="@layout/content_main" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_docked"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/Widget.OpenHub.BottomNav.Indicator"
        app:itemGravity="center"
        app:itemIconSize="20dp"
        app:itemPaddingTop="4dp"
        app:itemPaddingBottom="4dp"
        app:activeIndicatorLabelPadding="3dp"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemTextAppearanceActive="@style/TextAppearance.OpenHub.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.OpenHub.BottomNav.Inactive"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>