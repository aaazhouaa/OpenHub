<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Rounded corner background for search history dropdown.
  ~ No shadow: padding keeps list content inside the rounded card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/card_background" />
    <corners android:radius="16dp" />
    <padding
        android:left="4dp"
        android:top="8dp"
        android:right="4dp"
        android:bottom="8dp" />
</shape>
